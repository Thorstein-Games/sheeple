  "private": true,
  "scripts": {
    "predev": "lsof -ti:3000,3001 2>/dev/null | xargs kill -9 2>/dev/null || true",
    "dev": "tsx watch server.ts",
    "dev:basic": "next dev",
    "build": "next build",
    "buildev": "pnpm build && pnpm dev",
