# Netlify rules for the build in scripts/build-netlify.mjs (everything lives
# under /sheeple). Moved to the publish root at build time. First match wins.
#
# thorsteingames.com/sheeple proxies to sheeple-game.com/sheeple/, so nothing
# under /sheeple may ever redirect: that would loop back through the proxy.

# Room pages are one static shell that reads the code from the URL.
/sheeple/room/*/spectate  /sheeple/room/_/spectate.html  200
/sheeple/room/*           /sheeple/room/_.html           200
/sheeple                  /sheeple/index.html            200
# Existing files are served as-is; anything else under /sheeple is a 404.
/sheeple/*                /sheeple/404.html              404

# Old sheeple-game.com URLs (/, /lobby, /room/ABCD, ...) moved to
# thorsteingames.com/sheeple.
https://sheeple-game.com/*      https://thorsteingames.com/sheeple/:splat  301!
https://www.sheeple-game.com/*  https://thorsteingames.com/sheeple/:splat  301!

/  /sheeple/  301
